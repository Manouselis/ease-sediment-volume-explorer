# Keep survey data out of Git. Only the public Rijkswaterstaat example is tracked.
/data/*
!/data/demo_boundary.geojson
!/data/demo_current.csv
!/data/demo_metadata.json
!/data/demo_reference.csv
!/data/demo_rws_coverage.xml
!/data/demo_rws_metadata.xml
!/data/demo_rws_wcs.txt
